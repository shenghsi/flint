#!/usr/bin/env node --redirect-warnings=/dev/null

const { execFileSync } = require("child_process");

const REPO_URL = "https://github.com/shenghsi/flint";

main();

async function main() {
  let version = process.argv[2];
  let channel = process.argv[3];
  let parts = version.split(".");

  if (
    process.argv.length != 4 ||
    parts.length != 3 ||
    parts.find((part) => isNaN(part)) != null ||
    (channel != "stable" && channel != "preview")
  ) {
    console.log("Usage: draft-release-notes <version> {stable|preview}");
    process.exit(1);
  }

  let suffix = channel == "preview" ? "-pre" : "";
  let tag = `v${version}${suffix}`;
  let priorTag = getPriorTag(parts, tag, suffix);

  if (priorTag == null) {
    console.error(`No prior ${channel} tag found before ${tag}`);
    process.exit(0);
  }

  try {
    execFileSync("rm", ["-rf", "target/shallow_clone"]);
    execFileSync("git", [
      "clone",
      REPO_URL,
      "target/shallow_clone",
      "--filter=tree:0",
      "--no-checkout",
      "--branch",
      tag,
    ]);
    execFileSync("git", ["-C", "target/shallow_clone", "rev-parse", "--verify", tag]);
    execFileSync("git", ["-C", "target/shallow_clone", "rev-parse", "--verify", priorTag]);
  } catch (e) {
    console.error(e.stderr.toString());
    process.exit(1);
  }

  const newCommits = getCommits(priorTag, tag);

  let releaseNotes = [];
  let missing = [];
  let skipped = [];

  for (const commit of newCommits) {
    let link = `${REPO_URL}/pull/` + commit.pr;
    let notes = commit.releaseNotes;
    if (commit.pr == "") {
      link = `${REPO_URL}/commits/` + commit.hash;
    } else if (!notes.includes(`${REPO_URL}/issues`)) {
      notes = notes + " ([#" + commit.pr + "](" + link + "))";
    }

    if (commit.releaseNotes == "") {
      missing.push("- MISSING " + commit.firstLine + " " + link);
    } else if (commit.releaseNotes.startsWith("- N/A")) {
      skipped.push("- N/A " + commit.firstLine + " " + link);
    } else {
      releaseNotes.push(notes);
    }
  }

  if (releaseNotes.length === 0) {
    const compareUrl = `${REPO_URL}/compare/${priorTag}...${tag}#commits_bucket`;
    console.log(`No public-facing changes in this release. [View the commits](${compareUrl}).\n`);
  } else {
    console.log(releaseNotes.join("\n") + "\n");
  }
}

// Finds the highest existing tag on the same channel (stable tags have no
// suffix, preview tags end in "-pre") that is lower than the version being
// released. Tags aren't necessarily one patch apart - minor/major bumps and
// promotions from the preview to the stable channel both skip versions - so
// this walks the actual tag list on GitHub instead of decrementing the patch
// number.
function getPriorTag(currentVersionParts, currentTag, suffix) {
  const tagPattern = suffix
    ? /^v(\d+)\.(\d+)\.(\d+)-pre$/
    : /^v(\d+)\.(\d+)\.(\d+)$/;
  const [curMajor, curMinor, curPatch] = currentVersionParts.map(Number);

  const output = execFileSync("git", ["ls-remote", "--tags", REPO_URL], {
    encoding: "utf8",
  });

  let priorTag = null;
  let priorVersion = null;

  for (const line of output.split("\n")) {
    const refTag = line.split("refs/tags/")[1];
    if (!refTag || refTag.endsWith("^{}") || refTag === currentTag) {
      continue;
    }

    const match = refTag.match(tagPattern);
    if (!match) {
      continue;
    }

    const version = [Number(match[1]), Number(match[2]), Number(match[3])];
    const isLower =
      version[0] < curMajor ||
      (version[0] === curMajor && version[1] < curMinor) ||
      (version[0] === curMajor && version[1] === curMinor && version[2] < curPatch);
    if (!isLower) {
      continue;
    }

    const isHigherThanPrior =
      priorVersion == null ||
      version[0] > priorVersion[0] ||
      (version[0] === priorVersion[0] && version[1] > priorVersion[1]) ||
      (version[0] === priorVersion[0] &&
        version[1] === priorVersion[1] &&
        version[2] > priorVersion[2]);
    if (isHigherThanPrior) {
      priorVersion = version;
      priorTag = refTag;
    }
  }

  return priorTag;
}

function getCommits(oldTag, newTag) {
  const pullRequestNumbers = execFileSync(
    "git",
    ["-C", "target/shallow_clone", "log", `${oldTag}..${newTag}`, "--format=DIVIDER\n%H|||%B"],
    { encoding: "utf8" },
  )
    .replace(/\r\n/g, "\n")
    .split("DIVIDER\n")
    .filter((commit) => commit.length > 0)
    .map((commit) => {
      let [hash, firstLine] = commit.split("\n")[0].split("|||");
      let cherryPick = firstLine.match(/\(cherry-pick #([0-9]+)\)/)?.[1] || "";
      let pr = firstLine.match(/\(#(\d+)\)$/)?.[1] || "";
      let releaseNotes = (commit.split(/Release notes:.*\n/i)[1] || "")
        .split("\n\n")[0]
        .trim()
        .replace(/\n(?![\n-])/g, " ");

      if (releaseNotes.includes("<public_issue_number_if_exists>")) {
        releaseNotes = "";
      }

      return {
        hash,
        pr,
        cherryPick,
        releaseNotes,
        firstLine,
      };
    });

  return pullRequestNumbers;
}
